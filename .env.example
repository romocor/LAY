# --- IA (todo se configura dentro de LAY: Configuración → IA) ---
# Por defecto LAY usa IA LOCAL GRATIS (Ollama): no necesitas ninguna clave.
# Opcionales (capa gratuita): GEMINI_API_KEY (aistudio.google.com), GROQ_API_KEY (console.groq.com)
# Opcional de pago: ANTHROPIC_API_KEY
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# --- Remoto (genera con: python -c "import secrets;print(secrets.token_urlsafe(32))") ---
LAY_HUB_TOKEN=
LAY_MCP_TOKEN=
# 127.0.0.1 = solo este PC. Para el celular vía Tailscale usa la IP 100.x de Tailscale.
LAY_BIND=127.0.0.1

# --- Correo ---
# Gmail: guarda el JSON OAuth "Desktop app" en ~/.lay/gmail_credentials.json
OUTLOOK_CLIENT_ID=

# --- Blackboard (URL del feed iCal de tu calendario) ---
BLACKBOARD_ICS_URL=
BLACKBOARD_BASE_URL=
BLACKBOARD_TOKEN=
