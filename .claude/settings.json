{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Bash(python -m pytest:*)", "Bash(ruff:*)", "Bash(python scripts/verificar_mcp.py)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(pip install:*)",
      "mcp__lay-pc__sistema_estado", "mcp__lay-pc__archivos_buscar", "mcp__lay-pc__monitores_listar",
      "mcp__lay-pc__ventanas_listar"
    ],
    "ask": ["Bash(git push:*)", "mcp__lay-pc__teclado_escribir", "mcp__lay-pc__gmail_enviar", "mcp__lay-pc__outlook_enviar", "mcp__lay-pc__gmail_enviar_borrador", "mcp__lay-pc__outlook_enviar_borrador", "mcp__lay-pc__ventana_cerrar"],
    "deny": ["Read(./.env)", "Read(~/.lay/**)", "Edit(./.env)"]
  },
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "python .claude/hooks/session_start.py"}]}],
    "PreToolUse": [
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "python .claude/hooks/guard_bash.py"}]},
      {"matcher": "Edit|Write|MultiEdit", "hooks": [{"type": "command", "command": "python .claude/hooks/proteger_archivos.py"}]}
    ],
    "PostToolUse": [
      {"matcher": "Edit|Write|MultiEdit", "hooks": [{"type": "command", "command": "python .claude/hooks/post_edit.py"}]}
    ],
    "Stop": [{"hooks": [{"type": "command", "command": "python .claude/hooks/stop_verificar.py", "timeout": 200}]}],
    "Notification": [{"hooks": [{"type": "command", "command": "python .claude/hooks/notificar.py"}]}]
  }
}
